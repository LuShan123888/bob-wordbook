{
  "identifier": "com.cian.bobwordbook",
  "version": "3.4.1",
  "category": "translate",
  "name": "英语学习与单词本",
  "summary": "使用 AIHubMix 或本地 Codex 翻译和分析英语，以 Bob 原生词典展示单词并保存结构化 JSONL。",
  "icon": "143",
  "author": "Cian Lu",
  "homepage": "https://github.com/LuShan123888/bob-wordbook",
  "appcast": "https://raw.githubusercontent.com/LuShan123888/bob-wordbook/main/appcast.json",
  "minBobVersion": "1.8.0",
  "options": [
    {
      "identifier": "provider",
      "type": "menu",
      "title": "翻译服务",
      "defaultValue": "aihubmix",
      "menuValues": [
        {
          "title": "AIHubMix",
          "value": "aihubmix"
        },
        {
          "title": "本地 Codex（ChatGPT 登录）",
          "value": "local_codex"
        }
      ],
      "desc": "本地 Codex 由 helper 调用已登录的 Codex CLI，不需要 AIHubMix API Key。"
    },
    {
      "identifier": "apiKey",
      "type": "text",
      "title": "AIHubMix API Key",
      "textConfig": {
        "type": "secure",
        "placeholderText": "sk-..."
      },
      "desc": "仅在翻译服务选择 AIHubMix 时使用，不会写入 JSONL 或发送给本地辅助程序。"
    },
    {
      "identifier": "model",
      "type": "text",
      "title": "模型",
      "defaultValue": "gpt-4o-mini",
      "textConfig": {
        "type": "visible",
        "placeholderText": "gpt-4o-mini"
      },
      "desc": "填写 AIHubMix 模型广场中的模型 ID。"
    },
    {
      "identifier": "aiHubMixReasoningEffort",
      "type": "menu",
      "title": "AIHubMix 思考深度",
      "defaultValue": "auto",
      "menuValues": [
        { "title": "Auto（推荐，按模型默认）", "value": "auto" },
        { "title": "None（关闭思考）", "value": "none" },
        { "title": "Minimal", "value": "minimal" },
        { "title": "Low", "value": "low" },
        { "title": "Medium", "value": "medium" },
        { "title": "High", "value": "high" },
        { "title": "XHigh", "value": "xhigh" }
      ],
      "desc": "仅在翻译服务选择 AIHubMix 时使用；Auto 不发送参数，兼容性最好。具体档位是否生效取决于模型。"
    },
    {
      "identifier": "codexModel",
      "type": "text",
      "title": "Codex 模型",
      "defaultValue": "gpt-5.6-luna",
      "textConfig": {
        "type": "visible",
        "placeholderText": "gpt-5.6-luna"
      },
      "desc": "仅在翻译服务选择本地 Codex 时使用；日常翻译推荐 gpt-5.6-luna，优先质量可使用 gpt-5.6-terra。"
    },
    {
      "identifier": "codexReasoningEffort",
      "type": "menu",
      "title": "Codex 思考深度",
      "defaultValue": "none",
      "menuValues": [
        { "title": "None（推荐，翻译最快）", "value": "none" },
        { "title": "Low", "value": "low" },
        { "title": "Medium", "value": "medium" },
        { "title": "High", "value": "high" },
        { "title": "XHigh", "value": "xhigh" },
        { "title": "Max（消耗最高）", "value": "max" }
      ],
      "desc": "仅在翻译服务选择本地 Codex 时使用；日常翻译建议选择 None，复杂语法分析可选择 Low 或更高。"
    },
    {
      "identifier": "codexServiceTier",
      "type": "menu",
      "title": "Codex 速度模式",
      "defaultValue": "standard",
      "menuValues": [
        { "title": "Standard（推荐）", "value": "standard" },
        { "title": "Fast（更快、消耗更多用量）", "value": "fast" }
      ],
      "desc": "Fast 会使用更多 ChatGPT Codex 套餐用量；需要低延迟时再开启。"
    },
    {
      "identifier": "systemPrompt",
      "type": "text",
      "title": "System Prompt（可选）",
      "textConfig": {
        "type": "visible",
        "height": 160,
        "placeholderText": "留空使用内置英语学习 Prompt"
      },
      "desc": "支持 $query.text、$query.detectFromLang 和 $query.detectToLang；留空时自动按单词、短语或句子提供学习建议。"
    },
    {
      "identifier": "outputPath",
      "type": "text",
      "title": "JSONL 文件路径",
      "defaultValue": "~/Downloads/bob-wordbook.jsonl",
      "textConfig": {
        "type": "visible",
        "placeholderText": "~/Downloads/bob-wordbook.jsonl"
      },
      "desc": "必须是绝对路径或以 ~/ 开头，并以 .jsonl 结尾；不要输入反斜杠，~ 只能出现在开头。"
    }
  ]
}
